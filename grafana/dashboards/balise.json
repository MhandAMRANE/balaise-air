{
  "uid": "balise-air",
  "title": "Balise qualité de l'air",
  "tags": ["balise"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "État de la balise",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "balise-pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "balise-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT etat FROM mesures ORDER BY date_heure DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "mappings": [
            {
              "type": "value",
              "options": {
                "Good": { "text": "Bon", "color": "green", "index": 0 },
                "Moderate": { "text": "Moyen", "color": "orange", "index": 1 },
                "Poor": { "text": "Mauvais", "color": "red", "index": 2 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "/^etat$/" },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
