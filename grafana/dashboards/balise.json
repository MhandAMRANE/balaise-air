          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date_heure AS \"Date\", temperature AS \"Température (°C)\", humidite AS \"Humidité (%)\", air AS \"Air\", etat AS \"État\", cause AS \"Cause\" FROM mesures ORDER BY date_heure DESC LIMIT 20"
